
pipeline {
    agent { label 'docker-maven-trivy' }

    tools {
        maven 'maven3'
    }

    environment {
        SONAR_IP = '3.209.11.135'
        ECR_REGISTRY = '462819606004.dkr.ecr.us-east-1.amazonaws.com'
        IMAGE_REPO = "${ECR_REGISTRY}/project1-demo"
    }

    stages {

        stage('Check Project Structure') {
            steps {
                sh '''
                    echo "Current workspace:"
                    pwd

                    echo "Workspace files:"
                    ls -la

                    echo "Finding pom.xml:"
                    find "$WORKSPACE" -type f -name pom.xml -print

                    echo "Checking Dockerfile and deployment manifest:"
                    find "$WORKSPACE" -maxdepth 4 \
                    \\( -name Dockerfile -o -name deploy-svc.yaml \\) -print
                '''
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    mkdir -p "$WORKSPACE/.trivy-tmp"
                    mkdir -p "$WORKSPACE/.trivy-cache"

                    TMPDIR="$WORKSPACE/.trivy-tmp" trivy fs \
                      --cache-dir "$WORKSPACE/.trivy-cache" \
                      --exit-code 1 \
                      --severity HIGH,CRITICAL \
                      .
                '''
            }
        }

        stage('Build & Sonar') {
            steps {
                script {
                    def pomPath = sh(
                        script: "find . -type f -name pom.xml -print -quit",
                        returnStdout: true
                    ).trim()

                    if (!pomPath) {
                        error "pom.xml not found in Jenkins workspace!"
                    }

                    def projectDir = pomPath.substring(
                        0, pomPath.lastIndexOf('/') + 1
                    )

                    echo "Maven project directory: ${projectDir}"

                    dir(projectDir) {
                        withCredentials([
                            string(
                                credentialsId: 'sonarqube-token',
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {
                            sh '''
                                mvn clean verify \
                                org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                                -Dsonar.projectKey=gate-sonargate-demoproject \
                                -Dsonar.host.url=http://${SONAR_IP}:9000 \
                                -Dsonar.token="${SONAR_TOKEN}" \
                                -Dsonar.qualitygate.wait=true
                            '''
                        }
                    }
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-east-1 |
                    docker login --username AWS \
                    --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    export DOCKER_BUILDKIT=0

                    docker build --platform linux/amd64 \
                    -f "Project 01/project_files/Dockerfile" \
                    -t "$IMAGE_REPO:$BUILD_NUMBER" \
                    -t "$IMAGE_REPO:latest" \
                    "Project 01/java-maven"
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    mkdir -p "$WORKSPACE/.trivy-tmp"
                    mkdir -p "$WORKSPACE/.trivy-cache"

                    TMPDIR="$WORKSPACE/.trivy-tmp" trivy image \
                      --cache-dir "$WORKSPACE/.trivy-cache" \
                      --exit-code 1 \
                      --severity HIGH,CRITICAL \
                      "$IMAGE_REPO:$BUILD_NUMBER"
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    docker push "$IMAGE_REPO:$BUILD_NUMBER"
                    docker push "$IMAGE_REPO:latest"
                '''
            }
        }

        stage('Update Deployment') {
            steps {
                dir('Project 01/project_files') {
                    sh '''
                        sed -i "s|image:.*|image: $IMAGE_REPO:$BUILD_NUMBER|g" deploy-svc.yaml

                        echo "Updated deployment image:"
                        grep "image:" deploy-svc.yaml
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir('Project 01/project_files') {
                    sh '''
                        aws eks update-kubeconfig \
                          --region ap-south-1 \
                          --name cwvj-devsecops-eks \
                          --kubeconfig /home/jenkins/.kube/config

                        kubectl create ns cwvj-devsecops \
                          --dry-run=client -o yaml | kubectl apply -f -

                        kubectl apply -f deploy-svc.yaml

                        kubectl rollout status \
                          -n cwvj-devsecops \
                          deployment/cwvj-devsecops-demo \
                          --timeout=60s || {
                            kubectl rollout undo \
                              -n cwvj-devsecops \
                              deployment/cwvj-devsecops-demo || true
                            exit 1
                        }
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Build ${env.BUILD_NUMBER} succeeded"
        }

        failure {
            echo "Build ${env.BUILD_NUMBER} failed"
        }

        always {
            echo "Build ${env.BUILD_NUMBER} finished"
        }
    }
}
